<TERRAIN_GENERATION>

create_terrain MED_WATER
{
  base_terrain                   WATER
  number_of_clumps               22
  spacing_to_other_terrain_types 1
  land_percent                   40
}

create_terrain DEEP_WATER
{
  base_terrain                   MED_WATER
  number_of_clumps               12
  spacing_to_other_terrain_types 2
  land_percent                   18
}


create_terrain FOREST
{
  base_terrain                   GRASS
  spacing_to_other_terrain_types 5
  land_percent                   10
  number_of_clumps               12
  set_avoid_player_start_areas
  set_scale_by_groups
}

create_terrain GRASS3
{
  base_terrain                   GRASS
  number_of_clumps               18
  spacing_to_other_terrain_types 0
  land_percent                   8
  set_scale_by_size
}

create_terrain DIRT3
{
  base_terrain                   GRASS
  number_of_clumps               12
  spacing_to_other_terrain_types 0
  land_percent                   5
  set_scale_by_size
}


/* --- per-player forest ------------------------------------------
 * Each player's own land was painted SPAWN_PLACEHOLDER, so it can be
 * split into eight individually addressable regions and given its own
 * wood budget. A map-wide forest block spends its budget wherever
 * there is room, which is how a region like Britain ends up with most
 * of its wood in France where nobody can reach it.
 */

/* 1. split: one clump each consumes exactly one player region */
create_terrain PLACEHOLDER_TERRAIN_A
{
  base_terrain                   SPAWN_PLACEHOLDER
  land_percent                   100
  number_of_clumps               1
}

create_terrain PLACEHOLDER_TERRAIN_B
{
  base_terrain                   SPAWN_PLACEHOLDER
  land_percent                   100
  number_of_clumps               1
}

create_terrain PLACEHOLDER_TERRAIN_C
{
  base_terrain                   SPAWN_PLACEHOLDER
  land_percent                   100
  number_of_clumps               1
}

create_terrain PLACEHOLDER_TERRAIN_D
{
  base_terrain                   SPAWN_PLACEHOLDER
  land_percent                   100
  number_of_clumps               1
}

create_terrain PLACEHOLDER_TERRAIN_E
{
  base_terrain                   SPAWN_PLACEHOLDER
  land_percent                   100
  number_of_clumps               1
}

create_terrain PLACEHOLDER_TERRAIN_F
{
  base_terrain                   SPAWN_PLACEHOLDER
  land_percent                   100
  number_of_clumps               1
}

create_terrain PLACEHOLDER_TERRAIN_G
{
  base_terrain                   SPAWN_PLACEHOLDER
  land_percent                   100
  number_of_clumps               1
}

create_terrain PLACEHOLDER_TERRAIN_H
{
  base_terrain                   SPAWN_PLACEHOLDER
  land_percent                   100
  number_of_clumps               1
}

/* 2. grow: one budgeted forest per player, kept off the TC */
create_terrain FOREST
{
  base_terrain                   PLACEHOLDER_TERRAIN_A
  number_of_tiles                100
  number_of_clumps               3
  clumping_factor                15
  set_avoid_player_start_areas
}

create_terrain FOREST
{
  base_terrain                   PLACEHOLDER_TERRAIN_B
  number_of_tiles                100
  number_of_clumps               3
  clumping_factor                15
  set_avoid_player_start_areas
}

create_terrain FOREST
{
  base_terrain                   PLACEHOLDER_TERRAIN_C
  number_of_tiles                100
  number_of_clumps               3
  clumping_factor                15
  set_avoid_player_start_areas
}

create_terrain FOREST
{
  base_terrain                   PLACEHOLDER_TERRAIN_D
  number_of_tiles                100
  number_of_clumps               3
  clumping_factor                15
  set_avoid_player_start_areas
}

create_terrain FOREST
{
  base_terrain                   PLACEHOLDER_TERRAIN_E
  number_of_tiles                100
  number_of_clumps               3
  clumping_factor                15
  set_avoid_player_start_areas
}

create_terrain FOREST
{
  base_terrain                   PLACEHOLDER_TERRAIN_F
  number_of_tiles                100
  number_of_clumps               3
  clumping_factor                15
