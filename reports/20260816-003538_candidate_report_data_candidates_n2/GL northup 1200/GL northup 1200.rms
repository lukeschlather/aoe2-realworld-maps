/* GL northup 1200
 *
 * Real-world coastline encoded as create_land blocks, so this script is
 * self-contained: no companion .scx, no game files touched, and the engine
 * transfers it to other players automatically in multiplayer.
 *
 * Generated by rwmaps -- projection laea, 240x240 tiles
 */

#const MAPSCALE_MODIFIER 1
#include_drs includes/scaling.inc

#define PALAEARCTIC_EUROPE_TEMPERATE

/* Every resource role pinned to one skin, so a region looks the same in
 * every generation and the analysis tables stay exact. themes.inc would
 * otherwise re-roll these per generation. */
#define MAP_CONSTANTS
if MAP_CONSTANTS
  #const STRAGGLER_SPAWN          349
  #const STRAGGLER_NEUTRAL        349
  #const BEACH_TERRAIN            2

  #const FORAGE_PLANT             59
  #const HERDABLE_A               594
  #const HUNTABLE_A               65
  #const HUNTABLE_SMALL_A         2100
  #const LUREABLE_A               48

  #const NERITIC_A                69
  #const SALTWATER_A              457
  #const FRESHWATER_A             456
  #const WHALE_A                  2625
endif

#include_drs includes/themes.inc
#include_drs includes/constants.inc

<PLAYER_SETUP>
  #include_drs includes/preliminaries.inc
  #include_drs includes/gaia_civilisation.inc

  #define WATER_OCEAN
  #include_drs includes/water_preset.inc
  water_definition WATER_PRESET

  direct_placement
  ai_info_map_type COASTAL 0 0

<LAND_GENERATION>

base_terrain WATER

