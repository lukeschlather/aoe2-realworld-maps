{
  base_terrain                   MED_WATER
  number_of_clumps               12
  spacing_to_other_terrain_types 2
  land_percent                   18
}


create_terrain FOREST
{
  base_terrain                   GRASS
  spacing_to_other_terrain_types 3
  land_percent                   5
  number_of_clumps               36
  set_avoid_player_start_areas
  set_scale_by_groups
}

