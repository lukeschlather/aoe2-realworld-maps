create_elevation        7
{
  base_terrain                GRASS
  number_of_clumps            8
  number_of_tiles             600
  set_scale_by_groups
  set_scale_by_size
}

<OBJECTS_GENERATION>

/* --- scaffolding ------------------------------------------------ */

  #const RESOURCE_SPACING_DEFAULT 4
  #const RESOURCE_SPACING_FAR     10
  #const RESOURCE_RESTRICTION     1

  /* actor areas 2000/2010/2020 (neutral zones) and 2030 (shore),
   * plus the object groups everything else avoids. Without this the
   * avoid_actor_area lines below have nothing to avoid and piles can
   * land on top of each other. */
  #include_drs includes/object_setup.inc

/* --- the start itself -------------------------------------------- */

  /* The 1999 include placed TOWN_CENTER and VILLAGER itself, so these
   * are mandatory now rather than optional. */
  #include_drs includes/town_centres.inc
  #include_drs includes/villagers.inc
  #include_drs includes/scouts.inc

  /* The wood a player chops in the first minutes. RESOURCE_TEMPLATES.md
   * calls this the single biggest gap in what we generated before -
   * we placed none at all. 50 of 52 System A maps include it. */
  #include_drs includes/stragglers.inc

/* --- gold / stone / berries -------------------------------------- */

  #const FORAGE_BUSH_PRIMARY_DISTANCE 10
  #const FORAGE_BUSH_PRIMARY_ZONE_DISTANCE 4
  #define FORAGE_BUSH_PRIMARY

  #const GOLD_PRIMARY_DISTANCE 9
  #const GOLD_PRIMARY_ZONE_DISTANCE 4
  #define GOLD_PRIMARY
  #const GOLD_SECONDARY_DISTANCE 16
  #const GOLD_SECONDARY_ZONE_DISTANCE 4
  #define GOLD_SECONDARY

  #const STONE_PRIMARY_DISTANCE 9
  #const STONE_PRIMARY_ZONE_DISTANCE 4
  #define STONE_PRIMARY
  #const STONE_SECONDARY_DISTANCE 16
  #const STONE_SECONDARY_ZONE_DISTANCE 4
  #define STONE_SECONDARY

  #include_drs includes/starting_resources.inc

/* --- food --------------------------------------------------------- */

  #define HERDABLE_STARTING_COUNT_FOUR
  #include_drs includes/herdable_starting.inc
  #include_drs includes/herdable.inc

  #const HUNTABLE_COUNT  4
  #const HUNTABLE_GROUPS 1
  #include_drs includes/huntable.inc

  #const LUREABLE_DISTANCE 12
  #const LUREABLE_GROUPS 2
  #include_drs includes/lureable.inc

/* --- water food ---------------------------------------------------- */

  /* Modern fish placement uses the role includes rather than the
   * hand-rolled SHORE_FISH/FISH/SALMON/MARLIN blocks this project used
   * to emit, which had to guess at legal water. */
  #const NERITIC_SPACING 20
  #include_drs includes/neritic.inc

  #const SALTWATER_COUNT 1024
  #include_drs includes/aquatic_saltwater.inc

  #const FRESHWATER_COUNT 0
  #include_drs includes/aquatic_freshwater.inc

/* --- islands ------------------------------------------------------
 * resources_neutral.inc leaves the islands empty. Measured on Salish
 * Sea: it lifted neutral supply 0 -> 333, and all 333 landed on the
 * two landmasses that already had players, while five unowned islands
 * of 73-161 tiles - every one of them 100% open, unforested and
 * inside every checkable constraint - got nothing.
 *
 * These are that include's own blocks with a single clause removed,
 * max_distance_to_other_zones 8 - confirmed by capture to be the
 * cause, since it measures distance to a DIFFERENT zone and every
 * island sits across water from one.
 *
 * Gold and stone only. Neutral food is a weak prize - players switch
 * to farms late, so wood converts to food with minimal micro - and
 * the stock band agrees: Arabia places 24 neutral gold and 27
 * neutral stone against 0 forage and 3 deer.
 */

  create_object GOLD
  {
    number_of_objects 5
    number_of_groups 1024
    set_tight_grouping
    group_placement_radius 1
    min_distance_to_players 26
    set_circular_placement
    temp_min_distance_group_placement 40
    min_distance_group_placement 1
    avoid_forest_zone 2
    avoid_cliff_zone 2
    min_distance_to_map_edge 6
    actor_area 1210
    actor_area_radius 3
    avoid_actor_area 1000
    avoid_actor_area 1010
    avoid_actor_area 1020
    avoid_actor_area 1030
    avoid_actor_area 1035
    avoid_actor_area 1040
    avoid_actor_area 1045
    avoid_actor_area 1050
    avoid_actor_area 11000
    avoid_actor_area 11010
    avoid_actor_area 11020
    avoid_actor_area 1210
    avoid_actor_area 1220
    avoid_actor_area 1310
    avoid_actor_area 1320
    avoid_actor_area 20 /* Villagers */
    avoid_actor_area 30 /* Scout */
    avoid_actor_area 60 /* Straggler, Spawn */
  }

  create_object STONE
  {
    number_of_objects 5
    number_of_groups 1024
    set_tight_grouping
    group_placement_radius 1
    min_distance_to_players 26
    set_circular_placement
    temp_min_distance_group_placement 40
    min_distance_group_placement 1
    avoid_forest_zone 2
    avoid_cliff_zone 2
    min_distance_to_map_edge 6
    actor_area 1220
    actor_area_radius 3
    avoid_actor_area 1000
    avoid_actor_area 1010
    avoid_actor_area 1020
    avoid_actor_area 1030
    avoid_actor_area 1035
    avoid_actor_area 1040
    avoid_actor_area 1045
    avoid_actor_area 1050
    avoid_actor_area 11000
    avoid_actor_area 11010
    avoid_actor_area 11020
    avoid_actor_area 1210
    avoid_actor_area 1220
    avoid_actor_area 1310
    avoid_actor_area 1320
    avoid_actor_area 20 /* Villagers */
    avoid_actor_area 30 /* Scout */
    avoid_actor_area 60 /* Straggler, Spawn */
  }


/* --- neutral trees -------------------------------------------------
 * The loose wood between bases. We pinned STRAGGLER_NEUTRAL from the
 * day System A landed and never included the file that reads it, so
 * every region measured exactly 40 tree objects off forest terrain -
 * 5 per player from stragglers.inc and nothing else. Stock carries
 * 182 (Arabia) to 318 (Team Islands).
 */

  #const STRAGGLER_GROUPS   24
  #const STRAGGLER_DISTANCE 16
  #const STRAGGLER_SPACING  2
  #include_drs includes/stragglers_neutral.inc

/* --- relics ------------------------------------------------------- */

  #const RELIC_COUNT 10
  /* Without a RELIC_TYPE_* define the whole include is inert - which
   * is why every map this project shipped had zero relics. */
  #define RELIC_TYPE_BALANCED
  #include_drs includes/relics.inc

/* --- leftover space ----------------------------------------------- */

  /* gold/stone/forage/huntable at min_distance_to_players 100 with a
   * tolerant max_distance_to_other_zones 8. Great Wall runs this
   * unconditionally because it is land-starved; Arabia gates it
   * behind SPACIOUS_SETUP. Our regions are the Great Wall case. */
  #include_drs includes/remote_resources.inc
