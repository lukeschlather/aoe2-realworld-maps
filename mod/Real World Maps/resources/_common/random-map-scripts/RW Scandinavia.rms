{
  base_terrain                   PLACEHOLDER_TERRAIN_E
  number_of_tiles                100
  number_of_clumps               3
  clumping_factor                15
  set_avoid_player_start_areas
}

create_terrain FOREST
{
  base_terrain                   PLACEHOLDER_TERRAIN_F
  number_of_tiles                100
  number_of_clumps               3
  clumping_factor                15
  set_avoid_player_start_areas
}

create_terrain FOREST
{
  base_terrain                   PLACEHOLDER_TERRAIN_G
  number_of_tiles                100
  number_of_clumps               3
  clumping_factor                15
  set_avoid_player_start_areas
}

create_terrain FOREST
