  number_of_tiles                100
  number_of_clumps               3
  clumping_factor                15
  set_avoid_player_start_areas
}

/* 3. clean up: unused placeholder becomes ordinary land.
 * 16 passes each - one pass strands a scatter of
 * single tiles that the game then draws as a black placeholder
