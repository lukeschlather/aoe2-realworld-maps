/* Cramped Italy
 *
 * Real-world coastline encoded as create_land blocks, so this script is
 * self-contained: no companion .scx, no game files touched, and the engine
 * transfers it to other players automatically in multiplayer.
 *
 * Generated by rwmaps -- projection laea, 240x240 tiles
 */

<PLAYER_SETUP>
  direct_placement
  ai_info_map_type MEDITERRANEAN 0 0 0

<LAND_GENERATION>

base_terrain WATER

/* deliberate, fairness-checked start positions */
create_land
{
  terrain_type                  GRASS
  land_position                 14 9
  base_size                     3
  number_of_tiles               240
  other_zone_avoidance_distance 0
  clumping_factor                8
  assign_to_player              1
}

